  "workflows": [
    {
      "id": "plan-spec-upload",
      "title": "Plan and Specification Intake",
      "description": "Register locally uploaded plans and specifications, verify extraction quality, and release a controlled document set.",
      "fields": [
        {
          "key": "projectReference",
          "label": "Project reference",
          "type": "text",
          "required": true,
          "default": "PROJECT-DEMO-101"
        },
        {
          "key": "documentName",
          "label": "Document name",
          "type": "text",
          "required": true,
          "default": "Issued-for-bid architectural set"
        },
        {
          "key": "documentType",
          "label": "Document type",
          "type": "select",
          "required": true,
          "options": [
            "Plans",
            "Specifications",
            "Addendum",
            "Schedule"
          ],
          "default": "Plans"
        },
        {
          "key": "revision",
          "label": "Revision",
          "type": "text",
          "required": true,
          "default": "IFB-01"
        },
        {
          "key": "source",
          "label": "Source",
          "type": "select",
          "required": true,
          "options": [
            "Local upload",
            "Manual entry",
            "Sandbox connector"
          ],
          "default": "Local upload"
        }
      ],
      "states": [
        "uploaded",
        "extracting",
        "quality_review",
        "released"
      ],
      "transitions": [
        {
          "id": "plan-spec-upload-extracting",
          "label": "Move to extracting",
          "from": [
            "uploaded"
          ],
          "to": "extracting"
        },
        {
          "id": "plan-spec-upload-quality_review",
          "label": "Move to quality review",
          "from": [
            "extracting"
          ],
          "to": "quality_review"
        },
        {
          "id": "plan-spec-upload-released",
          "label": "Move to released",
          "from": [
            "quality_review"
          ],
          "to": "released"
        }
      ],
      "seeds": [
        {
          "id": "plan-spec-upload-demo",
          "state": "uploaded",
          "projectReference": "PROJECT-DEMO-101",
          "documentName": "Issued-for-bid architectural set",
          "documentType": "Plans",
          "revision": "IFB-01",
          "source": "Local upload"
        }
      ]
    },
    {
      "id": "bid-risk-analysis",
      "title": "Bid Risk Analysis",
      "description": "Identify scope, contract, schedule, and constructability risks and route material findings for bid leadership review.",
      "fields": [
        {
          "key": "projectReference",
          "label": "Project reference",
          "type": "text",
          "required": true,
          "default": "PROJECT-DEMO-101"
        },
        {
          "key": "riskCategory",
          "label": "Risk category",
          "type": "select",
          "required": true,
          "options": [
            "Scope gap",
            "Contract term",
            "Schedule",
            "Constructability",
            "Site condition"
          ],
          "default": "Scope gap"
        },
        {
          "key": "finding",
          "label": "Finding",
          "type": "textarea",
          "required": true,
          "default": "Temporary power responsibility is not assigned in the bid documents."
        },
        {
          "key": "severity",
          "label": "Severity",
          "type": "select",
          "required": true,
          "options": [
            "Low",
            "Medium",
            "High",
            "Critical"
          ],
          "default": "High"
        },
        {
          "key": "owner",
          "label": "Finding owner",
          "type": "text",
          "required": true,
          "default": "Demo Chief Estimator"
        }
      ],
      "states": [
        "queued",
        "analyzed",
        "estimator_review",
        "resolved"
      ],
      "transitions": [
        {
          "id": "bid-risk-analysis-analyzed",
          "label": "Move to analyzed",
          "from": [
            "queued"
          ],
          "to": "analyzed"
        },
        {
          "id": "bid-risk-analysis-estimator_review",
          "label": "Move to estimator review",
          "from": [
            "analyzed"
          ],
          "to": "estimator_review"
        },
        {
          "id": "bid-risk-analysis-resolved",
          "label": "Move to resolved",
          "from": [
            "estimator_review"
          ],
          "to": "resolved"
        }
      ],
      "seeds": [
        {
          "id": "bid-risk-analysis-demo",
          "state": "queued",
          "projectReference": "PROJECT-DEMO-101",
          "riskCategory": "Scope gap",
          "finding": "Temporary power responsibility is not assigned in the bid documents.",
          "severity": "High",
          "owner": "Demo Chief Estimator"
        }
      ]
    },
    {
      "id": "cost-estimate-review",
      "title": "Cost Estimate Review",
      "description": "Compare estimate assumptions with plan quantities and benchmarks, then approve or return material variances.",
      "fields": [
        {
          "key": "estimateReference",
          "label": "Estimate reference",
          "type": "text",
          "required": true,
          "default": "EST-DEMO-101-A"
        },
        {
          "key": "baselineCost",
          "label": "Baseline cost",
          "type": "number",
          "required": true,
          "default": 12850000
        },
        {
          "key": "reviewedCost",
          "label": "Reviewed cost",
          "type": "number",
          "required": true,
          "default": 13240000
        },
        {
          "key": "varianceReason",
          "label": "Variance reason",
          "type": "textarea",
          "required": true,
          "default": "Structural steel escalation and revised crane duration."
        },
        {
          "key": "contingencyPercent",
          "label": "Contingency percent",
          "type": "number",
          "required": true,
          "default": 7.5
        }
      ],
      "states": [
        "prepared",
        "variance_review",
        "approved",
        "locked"
      ],
      "transitions": [
        {
          "id": "cost-estimate-review-variance_review",
          "label": "Move to variance review",
          "from": [
            "prepared"
          ],
          "to": "variance_review"
        },
        {
          "id": "cost-estimate-review-approved",
          "label": "Move to approved",
          "from": [
            "variance_review"
          ],
          "to": "approved"
        },
        {
          "id": "cost-estimate-review-locked",
          "label": "Move to locked",
          "from": [
            "approved"
          ],
          "to": "locked"
        }
      ],
      "seeds": [
        {
          "id": "cost-estimate-review-demo",
          "state": "prepared",
          "estimateReference": "EST-DEMO-101-A",
          "baselineCost": 12850000,
          "reviewedCost": 13240000,
          "varianceReason": "Structural steel escalation and revised crane duration.",
          "contingencyPercent": 7.5
        }
      ]
    },
    {
      "id": "permit-checklist",
      "title": "Permit Checklist",
      "description": "Track jurisdictional permit requirements, evidence, status events, and blocking conditions through approval.",
      "fields": [
        {
          "key": "projectReference",
          "label": "Project reference",
          "type": "text",
          "required": true,
          "default": "PROJECT-DEMO-101"
