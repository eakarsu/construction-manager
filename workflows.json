        {
          "key": "permitType",
          "label": "Permit type",
          "type": "select",
          "required": true,
          "options": [
            "Building",
            "Electrical",
            "Mechanical",
            "Plumbing",
            "Environmental"
          ],
          "default": "Building"
        },
        {
          "key": "requiredEvidence",
          "label": "Required evidence",
          "type": "textarea",
          "required": true,
          "default": "Sealed drawings; energy statement; contractor registration"
        },
        {
          "key": "agencyStatus",
          "label": "Agency connection status",
          "type": "select",
          "required": true,
          "options": [
            "Not configured",
            "Needs credentials",
            "Test ready",
            "Blocked"
          ],
          "default": "Not configured"
        }
      ],
      "states": [
        "draft",
        "requirements_review",
        "submitted",
        "approved"
      ],
      "transitions": [
        {
          "id": "permit-checklist-requirements_review",
          "label": "Move to requirements review",
          "from": [
            "draft"
          ],
          "to": "requirements_review"
        },
        {
          "id": "permit-checklist-submitted",
          "label": "Move to submitted",
          "from": [
            "requirements_review"
          ],
          "to": "submitted"
        },
        {
          "id": "permit-checklist-approved",
          "label": "Move to approved",
          "from": [
            "submitted"
          ],
          "to": "approved"
        }
      ],
      "seeds": [
        {
          "id": "permit-checklist-demo",
          "state": "draft",
          "projectReference": "PROJECT-DEMO-101",
          "jurisdiction": "Demo City Building Department",
          "permitType": "Building",
          "requiredEvidence": "Sealed drawings; energy statement; contractor registration",
          "agencyStatus": "Not configured"
